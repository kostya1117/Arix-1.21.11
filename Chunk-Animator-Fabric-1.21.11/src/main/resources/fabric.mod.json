{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "Animates newly loaded chunks.",
  "authors": [
    "${mod_author}"
  ],
  "license": "All-Rights-Reserved",
  "environment": "client",
  "custom": {
    "modmenu": {
      "credits": "${mod_credits}"
    }
  },
  "entrypoints": {
    "client": [
      "astryxion.chunkanimator.ChunkAnimator"
    ]
  },
  "mixins": [
    "chunkanimator.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.1",
    "minecraft": "1.21.11",
    "fabric-api": "*"
  }
}
